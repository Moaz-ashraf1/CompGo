# Copy this to .env.dev on the server and fill in real values, then:
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
#
# Keep these DIFFERENT from the production secrets in the server's main
# .env - this is a separate database and separate token signing key on
# purpose, so a bug or a bad test in dev can never touch production data
# or forge a token that production would accept.

DEV_DB_PASSWORD=change-me-to-a-real-password
DEV_ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
