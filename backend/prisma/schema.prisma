generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum VehicleType {
  MOTORCYCLE
  CAR
  BICYCLE
}

enum ClientStatus {
  ACTIVE
  BLOCKED
}

enum CaptainStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum TripType {
  RIDE
  ORDER
  AIRPORT
}

enum TripStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AccountRole {
  CLIENT
  CAPTAIN
  ADMIN
}

enum PaymentMethod {
  CASH
  INSTAPAY
  WALLET
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  // A super admin can do everything and manage other admins (see
  // admin-users module). Everyone else is limited to `permissions`: a map
  // of dashboard section -> "VIEW" | "EDIT" (see utils/adminPermissions.ts).
  // A missing section means no access at all.
  isSuper      Boolean  @default(false)
  permissions  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id            String       @id @default(uuid())
  name          String
  phone         String       @unique
  gender        Gender
  passwordHash  String
  tripNum       Int          @default(0)
  // Bonus credit in EGP the client can spend on trips (see
  // modules/offers/credit.service.ts). Kept in step with
  // ClientCreditTransaction, which is the audit trail.
  creditBalance Decimal      @default(0) @db.Decimal(10, 2)
  status        ClientStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Captain {
  id                  String        @id @default(uuid())
  name                String
  phone               String        @unique
  gender              Gender
  passwordHash        String
  profilePhoto        String?
  nationalIdImage     String
  licenseImage        String
  // The vehicle's own registration/license photo, distinct from
  // `licenseImage` (the captain's personal driving license). Nullable
  // since captains registered before this field existed have none -
  // required at the API layer for every new registration (see
  // captain.validation.ts -> registerCaptainSchema).
  vehicleLicenseImage String?
  // Photo of the car itself (shown to clients and in the dashboard).
  // Nullable: older captains have none.
  vehiclePhoto        String?
  vehicleNumber       String        @unique
  vehicleType         VehicleType
  vehicleModel        String
  amountDue           Decimal       @default(0) @db.Decimal(10, 2)
  // Admin-configurable per captain - how often (in days) this captain's
  // dues should be collected/settled in person. Null means no cycle is
  // tracked for them. Paired with `lastSettledAt` (set whenever an admin
  // resets their amountDue - see captain.service.ts -> resetAmountDue) to
  // compute a next-due date and flag overdue captains in the dashboard.
  settlementCycleDays Int?
  // When true, the captain is blocked automatically once their dues stay
  // unpaid past `settlementCycleDays` (see jobs/autoBlockOverdue.ts).
  // `autoBlockedAt` marks that automatic block so it is not re-applied
  // after an admin unblocks them for the same overdue cycle.
  autoBlockOnOverdue  Boolean  @default(false)
  autoBlockedAt       DateTime?
  lastSettledAt       DateTime?
  // New signups start PENDING and need an admin to approve them (see
  // captain.service.ts -> getPendingCaptains, and login's status check)
  // before they can log in and start taking trips.
  status              CaptainStatus @default(PENDING)
  isAvailable         Boolean       @default(false)
  lastLat             Float?
  lastLng             Float?
  lastLocationAt      DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

/// A manual balance adjustment an admin makes on a captain's `amountDue`
/// (see admin.service.ts -> adjustCaptainBalance) - positive charges the
/// captain more (e.g. correcting a missed commission), negative pays them
/// out/reduces what they owe. Kept as its own audit trail separate from
/// the per-trip commission entries in the captain's wallet history.
enum WalletTransactionKind {
  ADJUSTMENT
  PENALTY
  COLLECTION
}

model WalletTransaction {
  id        String                @id @default(uuid())
  captainId String
  amount    Decimal               @db.Decimal(10, 2)
  reason    String
  // What kind of movement this is - the amount is always the change in the
  // captain's amountDue (positive = owes more, negative = owes less).
  kind      WalletTransactionKind @default(ADJUSTMENT)
  // How a COLLECTION was paid (INSTAPAY / VODAFONE_CASH / CASH / OTHER) and
  // an optional admin note - null for older rows and non-collections.
  method    String?
  note      String?
  // A recorded transfer the admin later cancelled. Cancelling adds a
  // reversing COLLECTION row (reversalOfId -> the cancelled one) so the
  // ledger stays append-only.
  cancelledAt DateTime?
  reversalOfId String?
  createdAt DateTime              @default(now())

  @@index([captainId, createdAt])
}

model RefreshToken {
  id        String      @id @default(uuid())
  accountId String
  role      AccountRole
  tokenHash String      @unique
  familyId  String
  deviceId  String
  ipAddress String
  revoked   Boolean     @default(false)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([accountId])
  @@index([familyId])
}

/// One row per device a captain/client has notifications enabled on.
/// `token` is unique per install - re-registering the same device just
/// updates `accountId`/`updatedAt` in place (covers logging into a
/// different account on the same phone).
model DeviceToken {
  id        String      @id @default(uuid())
  accountId String
  role      AccountRole
  token     String      @unique
  platform  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([accountId])
}

/// A persisted record of every push notification the backend ever sent -
/// exists independently of whether FCM is configured or the send actually
/// succeeded, so the in-app "كل الإشعارات" list always has real history
/// even before/without a working push channel. `data` mirrors the same
/// payload sent over the socket/push channels (e.g. {tripId, type}).
model Notification {
  id        String      @id @default(uuid())
  accountId String
  role      AccountRole
  title     String
  body      String
  data      Json?
  read      Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([accountId, createdAt])
}

/// In-trip chat between the client and the assigned captain - only exists
/// once a trip actually has both parties matched (see message.service.ts),
/// same privacy tier as when phone numbers get exposed elsewhere.
model Message {
  id         String      @id @default(uuid())
  tripId     String
  senderId   String
  senderRole AccountRole
  body       String
  createdAt  DateTime    @default(now())

  @@index([tripId, createdAt])
}

model CompoundBoundary {
  id        String   @id @default(uuid())
  points    Json
  updatedAt DateTime @updatedAt
}

/// General app-wide settings, singleton row (same pattern as
/// PricingConfig/CompoundBoundary above) - currently the support WhatsApp
/// number and email shown on the "تواصل معنا" page in both apps (see
/// app-settings.service.ts). Each is independently nullable - the admin
/// can configure either, both, or neither, and any unset channel just
/// doesn't render in the apps.
model AppSettings {
  id                               String   @id @default(uuid())
  // Digits only, international format, no leading +/00/0 (e.g.
  // "201001234567") - that's what a wa.me/<number> deep link needs.
  supportWhatsappNumber            String?
  supportEmail                     String?
  // Global cancellation-penalty policy (see trip.service.ts ->
  // cancelCaptainTrip): a captain's first `captainCancellationFreeLimit`
  // cancellations (all-time, counted from Trip.cancelledBy) are free -
  // every one after that automatically charges
  // `captainCancellationPenaltyAmount` to their wallet. Either being null
  // disables the penalty entirely.
  captainCancellationFreeLimit     Int?
  captainCancellationPenaltyAmount Decimal? @db.Decimal(10, 2)
  // Where a captain sends their settlement payment (see
  // settlement.service.ts -> submitSettlement) - shown to them once they
  // pick a SettlementPaymentMethod. Either being null hides that option.
  instapayNumber                   String?
  vodafoneCashNumber               String?
  // Client bonus program (see modules/offers). cashbackPercent: share of
  // what the client actually paid that comes back as credit after a
  // completed trip. welcomeBonusAmount: credit given at signup.
  // creditMaxUsagePercent: how much of a fare credit may cover (100 = all).
  cashbackPercent                  Decimal? @db.Decimal(5, 2)
  welcomeBonusAmount               Decimal? @db.Decimal(10, 2)
  creditMaxUsagePercent            Int      @default(100)
  updatedAt                        DateTime @updatedAt
}

enum CreditTransactionKind {
  GRANT
  CASHBACK
  WELCOME
  REDEMPTION
  REFUND
}

/// One movement of a client's bonus credit - positive adds, negative spends.
model ClientCreditTransaction {
  id        String                @id @default(uuid())
  clientId  String
  amount    Decimal               @db.Decimal(10, 2)
  kind      CreditTransactionKind
  reason    String
  tripId    String?
  createdAt DateTime              @default(now())

  @@index([clientId, createdAt])
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

/// An offer a client types in when requesting a trip. FIXED value is EGP,
/// PERCENT is % of the fare (optionally capped by maxDiscount).
model PromoCode {
  id             String            @id @default(uuid())
  code           String            @unique
  description    String?
  discountType   PromoDiscountType
  value          Decimal           @db.Decimal(10, 2)
  maxDiscount    Decimal?          @db.Decimal(10, 2)
  minFare        Decimal?          @db.Decimal(10, 2)
  validFrom      DateTime?
  validTo        DateTime?
  maxUses        Int?
  usedCount      Int               @default(0)
  perClientLimit Int               @default(1)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
}

model PromoRedemption {
  id          String   @id @default(uuid())
  promoCodeId String
  clientId    String
  tripId      String
  discount    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([promoCodeId, clientId])
}

enum SettlementPaymentMethod {
  INSTAPAY
  VODAFONE_CASH
}

enum SettlementStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A captain's claim that they paid their `amountDue` outside the app
/// (InstaPay/Vodafone Cash transfer) - `screenshotUrl` is the proof an
/// admin reviews before approving. Approving resets the captain's
/// amountDue to 0 (see settlement.service.ts -> approveSubmission); a
/// captain can only ever have one PENDING submission at a time.
model SettlementSubmission {
  id              String                  @id @default(uuid())
  captainId       String
  amount          Decimal                 @db.Decimal(10, 2)
  paymentMethod   SettlementPaymentMethod
  screenshotUrl   String
  status          SettlementStatus        @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime                @default(now())
  reviewedAt      DateTime?

  @@index([captainId])
  @@index([status])
}

/// An admin-defined performance tier a captain can qualify for over a
/// chosen date range (see reports.service.ts -> getCaptainBonusesReport) -
/// a captain meeting ALL of this tier's minimums earns bonusPercentage of
/// their trip revenue in that range as a bonus. A captain is matched to
/// whichever tier they qualify for with the highest bonusPercentage, not
/// just the first one that fits. `minAvgRating`/`maxCancellations` being
/// null means that criterion isn't required for this tier.
model CaptainBonusTier {
  id               String   @id @default(uuid())
  label            String
  minInsideTrips   Int      @default(0)
  minOutsideTrips  Int      @default(0)
  minAvgRating     Decimal? @db.Decimal(3, 2)
  maxCancellations Int?
  bonusPercentage  Decimal  @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum OutsideCompoundPricingMode {
  PER_KM
  FLAT
  THRESHOLD
  // Rate per km depends on the trip's total distance: outsideRateNearKm up
  // to outsideBandLimitKm, outsideRateFarKm beyond it - applied to the
  // WHOLE distance, not marginally (e.g. 12km at 12/km = 144, not 10*11+2*12).
  DISTANCE_BANDS
}

enum OrderPlacesPricingMode {
  FLAT
  PER_PLACE
  TIERED
}

model PricingConfig {
  id                         String                     @id @default(uuid())
  rideInsideCompoundPrice    Decimal                    @db.Decimal(10, 2)
  rideOutsidePricePerKm      Decimal                    @db.Decimal(10, 2)
  orderInsideCompoundPrice   Decimal                    @db.Decimal(10, 2)
  // Price for an ORDER trip whose pickup point is outside the compound -
  // null keeps the old behaviour of just reusing orderInsideCompoundPrice
  // (see trip.service.ts -> calculatePrice). Orders used to be rejected
  // entirely outside the compound (OrderOutsideCompoundError); that
  // restriction was removed once this field was added.
  orderOutsideCompoundPrice  Decimal?                   @db.Decimal(10, 2)
  commissionPercentage       Decimal                    @default(15) @db.Decimal(5, 2)
  airportPrice               Decimal                    @db.Decimal(10, 2)
  // How a RIDE trip starting outside the compound gets priced (see
  // trip.service.ts -> calculatePrice):
  //   PER_KM (default, original behaviour) - full distance * rideOutsidePricePerKm
  //   FLAT - outsideCompoundFlatPrice regardless of distance
  //   THRESHOLD - outsideCompoundBasePrice + rideOutsidePricePerKm for every
  //               km beyond outsideCompoundThresholdKm
  outsideCompoundMode        OutsideCompoundPricingMode @default(PER_KM)
  outsideCompoundFlatPrice   Decimal?                   @db.Decimal(10, 2)
  outsideCompoundBasePrice   Decimal?                   @db.Decimal(10, 2)
  outsideCompoundThresholdKm Decimal?                   @db.Decimal(10, 2)
  // How an ORDER trip covering more than one pickup place gets priced
  // (see trip.service.ts -> calculatePrice):
  //   FLAT (default, original behaviour) - always orderInsideCompoundPrice
  //   PER_PLACE - orderInsideCompoundPrice for the first place, plus
  //               orderExtraPlacePrice for every place beyond it
  //   TIERED - orderInsideCompoundPrice for 1 place, then orderPlaceTiers
  //            is a JSON array of {minPlaces, price} set by the admin -
  //            the tier with the highest minPlaces <= placesCount wins
  //            (e.g. [{minPlaces:2,price:80},{minPlaces:3,price:120}])
  orderPlacesMode            OrderPlacesPricingMode     @default(FLAT)
  orderExtraPlacePrice       Decimal?                   @db.Decimal(10, 2)
  orderPlaceTiers            Json?
  // DISTANCE_BANDS mode inputs (see OutsideCompoundPricingMode).
  outsideBandLimitKm         Decimal?                   @db.Decimal(10, 2)
  outsideRateNearKm          Decimal?                   @db.Decimal(10, 2)
  outsideRateFarKm           Decimal?                   @db.Decimal(10, 2)
  // Fixed airport entry fee ("كارتة") added to every airport trip's fare.
  // Leave null when the client pays it at the gate instead.
  airportCardFee             Decimal?                   @db.Decimal(10, 2)
  // Company share per trip category, e.g.
  //   { "RIDE_INSIDE": { "mode": "FIXED", "value": 7, "onTop": false },
  //     "RIDE_OUTSIDE": { "mode": "FIXED", "value": 20, "onTop": true } }
  // mode: FIXED (value is EGP) or PERCENT (value is % of the fare).
  // onTop: false = the share is taken out of what the client pays;
  // true = it is added on top of the fare (client pays fare + share).
  // A category with no rule falls back to `commissionPercentage`, taken
  // out of the fare (the original behaviour). See utils/commission.ts.
  commissionRules            Json?
  updatedAt                  DateTime                   @updatedAt
}

model Trip {
  id                   String        @id @default(uuid())
  type                 TripType
  status               TripStatus    @default(REQUESTED)
  clientId             String
  captainId            String?
  pickupLat            Decimal       @db.Decimal(10, 7)
  pickupLng            Decimal       @db.Decimal(10, 7)
  pickupLabel          String
  dropoffLat           Decimal?      @db.Decimal(10, 7)
  dropoffLng           Decimal?      @db.Decimal(10, 7)
  dropoffLabel         String?
  isInsideCompound     Boolean
  distanceKm           Decimal?      @db.Decimal(10, 2)
  price                Decimal       @db.Decimal(10, 2)
  cancelReason         String?
  // Who cancelled it - null for a trip that was never cancelled, or one
  // cancelled before this field existed. Drives the "captain cancellation
  // count" used by the bonus report (see reports.service.ts ->
  // getCaptainBonusesReport) - only CAPTAIN-initiated cancellations count
  // against a captain there, not client-initiated ones.
  cancelledBy          AccountRole?
  paymentMethod        PaymentMethod @default(CASH)
  // Only a FEMALE client may set this (enforced in trip.service.ts ->
  // requestTrip) - restricts which captains can see/accept the trip to
  // FEMALE captains only (see getAvailableTrips/acceptTrip).
  femaleCaptainOnly    Boolean       @default(false)
  // The company's cut of this trip in EGP, fixed when the trip is requested
  // so later pricing changes never rewrite history. Null on trips created
  // before this existed (they fall back to price * commissionPercentage).
  companyShare         Decimal?      @db.Decimal(10, 2)
  // Promo-code discount and bonus credit applied to this trip. `price` stays
  // the full fare (captain earnings, commission and reports are based on
  // it); the client only pays price - discountAmount - creditUsed in cash,
  // and the company covers the difference (see trip.service.ts ->
  // completeTrip).
  discountAmount       Decimal?      @db.Decimal(10, 2)
  creditUsed           Decimal?      @db.Decimal(10, 2)
  promoCodeId          String?
  // Advance-booking details, currently only meaningful for AIRPORT trips.
  // A trip is still created and matched immediately on request either
  // way - there's no scheduler yet that holds a trip until scheduledAt.
  scheduledAt          DateTime?
  // Set once the trip is actually shown to captains (see trip.service.ts
  // -> dispatchTripToCaptains) - immediately for a normal/unscheduled
  // trip, or later by the scheduled-trip dispatcher job once `scheduledAt`
  // is within its lead window. Null means captains have never seen it yet.
  dispatchedAt         DateTime?
  passengers           Int?
  luggageCount         Int?
  flightNumber         String?
  // How many separate pickup places an ORDER trip combined into one
  // request (see trip.service.ts -> calculatePrice) - null/1 for a
  // single-place order, and for every other trip type.
  placesCount          Int?
  // Set once by the client after a COMPLETED trip (see trip.service.ts
  // -> rateTrip). 1-5, enforced in trip.validation.ts, not at the DB
  // level.
  rating               Int?
  ratingComment        String?
  // Set once each the first time a captain location update crosses the
  // "near"/"arrived" distance threshold to the pickup point (see
  // trip.service.ts -> notifyCaptainLocationUpdate) - so those push
  // notifications fire exactly once per trip instead of on every tick.
  nearPickupNotifiedAt DateTime?
  arrivedNotifiedAt    DateTime?
  requestedAt          DateTime      @default(now())
  acceptedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Individually-trackable pickup places for a multi-place ORDER trip
  // (see trip.service.ts -> requestTrip/togglePlaceCollected) - empty for
  // every other trip type, and for an ORDER trip requested before this
  // existed (those only have the flattened `pickupLabel` text).
  places TripPlace[]

  @@index([clientId])
  @@index([captainId])
  @@index([status])
}

/// One pickup item within a multi-place ORDER trip, checked off by the
/// captain as they collect it (see trip.service.ts ->
/// togglePlaceCollected) - the client sees this list update live via
/// socket + gets a push notification on each check.
model TripPlace {
  id          String    @id @default(uuid())
  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name        String
  details     String?
  order       Int
  collected   Boolean   @default(false)
  collectedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tripId])
}

enum LegalPageKey {
  TERMS_CLIENT
  TERMS_CAPTAIN
  PRIVACY_CLIENT
  PRIVACY_CAPTAIN
  HELP_CLIENT
  HELP_CAPTAIN
}

/// Admin-edited terms / privacy text shown in the client and captain apps
/// (see modules/legal). `sections` is a list of { heading, body }. A page
/// with no row falls back to the built-in text in legal.defaults.ts.
model LegalPage {
  key       LegalPageKey @id
  sections  Json
  updatedAt DateTime     @updatedAt
}

enum FamilyRelation {
  FATHER
  MOTHER
  SON
  DAUGHTER
  HUSBAND
  WIFE
  BROTHER
  SISTER
  OTHER
}

enum FamilyLinkStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A relationship one client asked another to confirm (see modules/family).
/// `relation` is what the TARGET is to the REQUESTER ("he is my father").
/// Once ACCEPTED, who gets notified about whose trips follows from it:
/// a parent follows their child, spouses follow each other, anyone else is
/// only linked (family.service.ts -> watchDirection).
model FamilyLink {
  id          String           @id @default(uuid())
  requesterId String
  targetId    String
  relation    FamilyRelation
  status      FamilyLinkStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, targetId])
  @@index([targetId])
}
