generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum VehicleType {
  MOTORCYCLE
  CAR
  BICYCLE
}

enum ClientStatus {
  ACTIVE
  BLOCKED
}

enum CaptainStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum TripType {
  RIDE
  ORDER
  AIRPORT
}

enum TripStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AccountRole {
  CLIENT
  CAPTAIN
  ADMIN
}

enum PaymentMethod {
  CASH
  INSTAPAY
  WALLET
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id           String       @id @default(uuid())
  name         String
  phone        String       @unique
  gender       Gender
  passwordHash String
  tripNum      Int          @default(0)
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Captain {
  id                  String        @id @default(uuid())
  name                String
  phone               String        @unique
  gender              Gender
  passwordHash        String
  profilePhoto        String?
  nationalIdImage     String
  licenseImage        String
  // The vehicle's own registration/license photo, distinct from
  // `licenseImage` (the captain's personal driving license). Nullable
  // since captains registered before this field existed have none -
  // required at the API layer for every new registration (see
  // captain.validation.ts -> registerCaptainSchema).
  vehicleLicenseImage String?
  vehicleNumber       String        @unique
  vehicleType         VehicleType
  vehicleModel        String
  amountDue           Decimal       @default(0) @db.Decimal(10, 2)
  // New signups start PENDING and need an admin to approve them (see
  // captain.service.ts -> getPendingCaptains, and login's status check)
  // before they can log in and start taking trips.
  status              CaptainStatus @default(PENDING)
  isAvailable         Boolean       @default(false)
  lastLat             Float?
  lastLng             Float?
  lastLocationAt      DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

/// A manual balance adjustment an admin makes on a captain's `amountDue`
/// (see admin.service.ts -> adjustCaptainBalance) - positive charges the
/// captain more (e.g. correcting a missed commission), negative pays them
/// out/reduces what they owe. Kept as its own audit trail separate from
/// the per-trip commission entries in the captain's wallet history.
model WalletTransaction {
  id        String   @id @default(uuid())
  captainId String
  amount    Decimal  @db.Decimal(10, 2)
  reason    String
  createdAt DateTime @default(now())

  @@index([captainId, createdAt])
}

model RefreshToken {
  id        String      @id @default(uuid())
  accountId String
  role      AccountRole
  tokenHash String      @unique
  familyId  String
  deviceId  String
  ipAddress String
  revoked   Boolean     @default(false)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([accountId])
  @@index([familyId])
}

/// One row per device a captain/client has notifications enabled on.
/// `token` is unique per install - re-registering the same device just
/// updates `accountId`/`updatedAt` in place (covers logging into a
/// different account on the same phone).
model DeviceToken {
  id        String      @id @default(uuid())
  accountId String
  role      AccountRole
  token     String      @unique
  platform  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([accountId])
}

/// A persisted record of every push notification the backend ever sent -
/// exists independently of whether FCM is configured or the send actually
/// succeeded, so the in-app "كل الإشعارات" list always has real history
/// even before/without a working push channel. `data` mirrors the same
/// payload sent over the socket/push channels (e.g. {tripId, type}).
model Notification {
  id        String      @id @default(uuid())
  accountId String
  role      AccountRole
  title     String
  body      String
  data      Json?
  read      Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([accountId, createdAt])
}

/// In-trip chat between the client and the assigned captain - only exists
/// once a trip actually has both parties matched (see message.service.ts),
/// same privacy tier as when phone numbers get exposed elsewhere.
model Message {
  id         String      @id @default(uuid())
  tripId     String
  senderId   String
  senderRole AccountRole
  body       String
  createdAt  DateTime    @default(now())

  @@index([tripId, createdAt])
}

model CompoundBoundary {
  id        String   @id @default(uuid())
  points    Json
  updatedAt DateTime @updatedAt
}

/// General app-wide settings, singleton row (same pattern as
/// PricingConfig/CompoundBoundary above) - currently the support WhatsApp
/// number and email shown on the "تواصل معنا" page in both apps (see
/// app-settings.service.ts). Each is independently nullable - the admin
/// can configure either, both, or neither, and any unset channel just
/// doesn't render in the apps.
model AppSettings {
  id                    String   @id @default(uuid())
  // Digits only, international format, no leading +/00/0 (e.g.
  // "201001234567") - that's what a wa.me/<number> deep link needs.
  supportWhatsappNumber String?
  supportEmail          String?
  updatedAt             DateTime @updatedAt
}

/// An admin-defined performance tier a captain can qualify for over a
/// chosen date range (see reports.service.ts -> getCaptainBonusesReport) -
/// a captain meeting ALL of this tier's minimums earns bonusPercentage of
/// their trip revenue in that range as a bonus. A captain is matched to
/// whichever tier they qualify for with the highest bonusPercentage, not
/// just the first one that fits. `minAvgRating`/`maxCancellations` being
/// null means that criterion isn't required for this tier.
model CaptainBonusTier {
  id               String   @id @default(uuid())
  label            String
  minInsideTrips   Int      @default(0)
  minOutsideTrips  Int      @default(0)
  minAvgRating     Decimal? @db.Decimal(3, 2)
  maxCancellations Int?
  bonusPercentage  Decimal  @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum OutsideCompoundPricingMode {
  PER_KM
  FLAT
  THRESHOLD
}

enum OrderPlacesPricingMode {
  FLAT
  PER_PLACE
  TIERED
}

model PricingConfig {
  id                         String                     @id @default(uuid())
  rideInsideCompoundPrice    Decimal                    @db.Decimal(10, 2)
  rideOutsidePricePerKm      Decimal                    @db.Decimal(10, 2)
  orderInsideCompoundPrice   Decimal                    @db.Decimal(10, 2)
  commissionPercentage       Decimal                    @default(15) @db.Decimal(5, 2)
  airportPrice               Decimal                    @db.Decimal(10, 2)
  // How a RIDE trip starting outside the compound gets priced (see
  // trip.service.ts -> calculatePrice):
  //   PER_KM (default, original behaviour) - full distance * rideOutsidePricePerKm
  //   FLAT - outsideCompoundFlatPrice regardless of distance
  //   THRESHOLD - outsideCompoundBasePrice + rideOutsidePricePerKm for every
  //               km beyond outsideCompoundThresholdKm
  outsideCompoundMode        OutsideCompoundPricingMode @default(PER_KM)
  outsideCompoundFlatPrice   Decimal?                   @db.Decimal(10, 2)
  outsideCompoundBasePrice   Decimal?                   @db.Decimal(10, 2)
  outsideCompoundThresholdKm Decimal?                   @db.Decimal(10, 2)
  // How an ORDER trip covering more than one pickup place gets priced
  // (see trip.service.ts -> calculatePrice):
  //   FLAT (default, original behaviour) - always orderInsideCompoundPrice
  //   PER_PLACE - orderInsideCompoundPrice for the first place, plus
  //               orderExtraPlacePrice for every place beyond it
  //   TIERED - orderInsideCompoundPrice for 1 place, then orderPlaceTiers
  //            is a JSON array of {minPlaces, price} set by the admin -
  //            the tier with the highest minPlaces <= placesCount wins
  //            (e.g. [{minPlaces:2,price:80},{minPlaces:3,price:120}])
  orderPlacesMode            OrderPlacesPricingMode     @default(FLAT)
  orderExtraPlacePrice       Decimal?                   @db.Decimal(10, 2)
  orderPlaceTiers            Json?
  updatedAt                  DateTime                   @updatedAt
}

model Trip {
  id                   String        @id @default(uuid())
  type                 TripType
  status               TripStatus    @default(REQUESTED)
  clientId             String
  captainId            String?
  pickupLat            Decimal       @db.Decimal(10, 7)
  pickupLng            Decimal       @db.Decimal(10, 7)
  pickupLabel          String
  dropoffLat           Decimal?      @db.Decimal(10, 7)
  dropoffLng           Decimal?      @db.Decimal(10, 7)
  dropoffLabel         String?
  isInsideCompound     Boolean
  distanceKm           Decimal?      @db.Decimal(10, 2)
  price                Decimal       @db.Decimal(10, 2)
  cancelReason         String?
  // Who cancelled it - null for a trip that was never cancelled, or one
  // cancelled before this field existed. Drives the "captain cancellation
  // count" used by the bonus report (see reports.service.ts ->
  // getCaptainBonusesReport) - only CAPTAIN-initiated cancellations count
  // against a captain there, not client-initiated ones.
  cancelledBy          AccountRole?
  paymentMethod        PaymentMethod @default(CASH)
  // Only a FEMALE client may set this (enforced in trip.service.ts ->
  // requestTrip) - restricts which captains can see/accept the trip to
  // FEMALE captains only (see getAvailableTrips/acceptTrip).
  femaleCaptainOnly    Boolean       @default(false)
  // Advance-booking details, currently only meaningful for AIRPORT trips.
  // A trip is still created and matched immediately on request either
  // way - there's no scheduler yet that holds a trip until scheduledAt.
  scheduledAt          DateTime?
  // Set once the trip is actually shown to captains (see trip.service.ts
  // -> dispatchTripToCaptains) - immediately for a normal/unscheduled
  // trip, or later by the scheduled-trip dispatcher job once `scheduledAt`
  // is within its lead window. Null means captains have never seen it yet.
  dispatchedAt         DateTime?
  passengers           Int?
  luggageCount         Int?
  flightNumber         String?
  // How many separate pickup places an ORDER trip combined into one
  // request (see trip.service.ts -> calculatePrice) - null/1 for a
  // single-place order, and for every other trip type.
  placesCount          Int?
  // Set once by the client after a COMPLETED trip (see trip.service.ts
  // -> rateTrip). 1-5, enforced in trip.validation.ts, not at the DB
  // level.
  rating               Int?
  ratingComment        String?
  // Set once each the first time a captain location update crosses the
  // "near"/"arrived" distance threshold to the pickup point (see
  // trip.service.ts -> notifyCaptainLocationUpdate) - so those push
  // notifications fire exactly once per trip instead of on every tick.
  nearPickupNotifiedAt DateTime?
  arrivedNotifiedAt    DateTime?
  requestedAt          DateTime      @default(now())
  acceptedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([clientId])
  @@index([captainId])
  @@index([status])
}
