generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum VehicleType {
  MOTORCYCLE
  CAR
  BICYCLE
}

enum ClientStatus {
  ACTIVE
  BLOCKED
}

enum CaptainStatus {
  ACTIVE
  BLOCKED
}

enum AccountRole {
  CLIENT
  CAPTAIN
}

model Client {
  id           String       @id @default(uuid())
  name         String
  phone        String       @unique
  gender       Gender
  passwordHash String
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Captain {
  id              String        @id @default(uuid())
  name            String
  phone           String        @unique
  gender          Gender
  passwordHash    String
  nationalIdImage String
  licenseImage    String
  vehicleNumber   String        @unique
  vehicleType     VehicleType
  vehicleModel    String
  amountDue       Decimal       @default(0) @db.Decimal(10, 2)
  status          CaptainStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model RefreshToken {
  id        String      @id @default(uuid())
  accountId String
  role      AccountRole
  tokenHash String      @unique
  familyId  String
  deviceId  String
  ipAddress String
  revoked   Boolean     @default(false)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([accountId])
  @@index([familyId])
}

model CompoundBoundary {
  id        String   @id @default(uuid())
  points    Json
  updatedAt DateTime @updatedAt
}

model PricingConfig {
  id                       String   @id @default(uuid())
  rideInsideCompoundPrice  Decimal  @db.Decimal(10, 2)
  rideOutsidePricePerKm    Decimal  @db.Decimal(10, 2)
  orderInsideCompoundPrice Decimal  @db.Decimal(10, 2)
  airportPrice             Decimal  @db.Decimal(10, 2)
  updatedAt                DateTime @updatedAt
}