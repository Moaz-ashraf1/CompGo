generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum VehicleType {
  MOTORCYCLE
  CAR
  BICYCLE
}

enum ClientStatus {
  ACTIVE
  BLOCKED
}

enum CaptainStatus {
  ACTIVE
  BLOCKED
}

enum AccountRole {
  CLIENT
  CAPTAIN
}

model RefreshToken {
  id        String      @id @default(uuid())
  userId    String
  role      AccountRole
  tokenHash String      @unique
  familyId  String
  deviceId  String
  ipAddress String
  revoked   Boolean     @default(false)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  gender    Gender
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client?
  captain Captain?
  refreshToken RefreshToken[]
}

model Client {
  id           String       @id @default(uuid())
  userId       String       @unique
  passwordHash String
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Captain {
  id              String        @id @default(uuid())
  userId          String        @unique
  passwordHash    String
  nationalIdImage String
  licenseImage    String
  vehicleNumber    String        @unique
  vehicleType     VehicleType
  vehicleModel    String
  amountDue       Decimal       @default(0) @db.Decimal(10, 2)
  status          CaptainStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model CompoundBoundary {
  id        String   @id @default(uuid())
  points    Json
  updatedAt DateTime @updatedAt
}

model PricingConfig {
  id                       String   @id @default(uuid())
  rideInsideCompoundPrice  Decimal  @db.Decimal(10, 2)
  rideOutsidePricePerKm    Decimal  @db.Decimal(10, 2)
  orderInsideCompoundPrice Decimal  @db.Decimal(10, 2)
  airportPrice             Decimal  @db.Decimal(10, 2)
  updatedAt                DateTime @updatedAt
}


