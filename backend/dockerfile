FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
# `npm ci` runs the `postinstall` script (`prisma generate`), which needs
# the schema present - copy it in before installing, not after, or the
# postinstall hook fails with "Could not find Prisma Schema".
COPY prisma ./prisma
RUN npm ci

COPY . .

ENV DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
RUN npx prisma generate

EXPOSE 3000

CMD ["npx", "tsx", "src/server.ts"]